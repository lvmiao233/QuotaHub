name: quotahub

services:
  quotahub:
    build: .
    image: ghcr.io/haoyang7/quotahub:latest
    container_name: quotahub
    restart: unless-stopped
    network_mode: host
    environment:
      QUOTAHUB_DATA: /data
      QUOTAHUB_LISTEN_HOST: "0.0.0.0"
      QUOTAHUB_LISTEN_PORT: "28787"
      QUOTAHUB_ADMIN_TOKEN: ${QUOTAHUB_ADMIN_TOKEN:?请在 .env 中设置至少32字符的管理令牌}
      QUOTAHUB_ENCRYPTION_KEY: ${QUOTAHUB_ENCRYPTION_KEY:?请在 .env 中设置Fernet密钥}
      QUOTAHUB_COOKIE_SECURE: ${QUOTAHUB_COOKIE_SECURE:-false}
      QUOTAHUB_LOG_LEVEL: ${QUOTAHUB_LOG_LEVEL:-INFO}
      # 出站 HTTPS 需要代理时填写，例如 http://127.0.0.1:7890
      HTTP_PROXY: ${HTTP_PROXY:-}
      HTTPS_PROXY: ${HTTPS_PROXY:-}
      NO_PROXY: ${NO_PROXY:-localhost,127.0.0.1,::1}
    volumes:
      - ./data:/data
    # 从 v0.1 / 初版 v0.2 升级时，可临时挂载 config.json 以导入账号与设置：
    # environment:
    #   QUOTAHUB_CONFIG: /data/config.json
    # volumes:
    #   - ./data:/data
    #   - ./config.json:/data/config.json:ro
