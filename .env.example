# 至少 32 字符。生成：python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
QUOTAHUB_ADMIN_TOKEN=

# Fernet 密钥。生成：python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
QUOTAHUB_ENCRYPTION_KEY=

# 生产 HTTPS 设置为 true；本地 HTTP 保持 false。
QUOTAHUB_COOKIE_SECURE=false

# 应用与定时任务日志级别：DEBUG、INFO、WARNING 或 ERROR。
QUOTAHUB_LOG_LEVEL=INFO
