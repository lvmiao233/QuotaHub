{
  "_comment": "v0.2 后请勿使用本配置文件，仅作为 v0.1 升级配置导入格式示例",
  "listen_host": "127.0.0.1",
  "listen_port": 28787,
  "refresh": {
    "ollama": {
      "auto_refresh": true,
      "interval_sec": 300
    },
    "opencode_go": {
      "auto_refresh": true,
      "interval_sec": 60
    }
  },
  "quota_sync": {
    "ollama": {
      "auto_sync": true,
      "interval_sec": 1800
    },
    "opencode_go": {
      "auto_sync": true,
      "interval_sec": 1800
    }
  },
  "opencode": {
    "usage_server_id": "bfd684bfc2e4eed05cd0b518f5e4eafd3f3376e3938abb9e536e7c03df831e5c"
  },
  "usage_sync": {
    "auto_sync": true,
    "interval_sec": 300,
    "backfill_pages_per_request": 5,
    "max_pages_per_incremental": 10
  },
  "import_accounts": {
    "opencode_accounts": [
      {
        "name": "OpenCodeAccount1",
        "workspace_id": "Default",
        "auth_cookie": "auth=YOUR_COOKIE_VALUE",
        "show_rolling": true,
        "show_weekly": true,
        "show_monthly": true,
        "enabled": true
      }
    ],
    "ollama_accounts": [
      {
        "name": "OllamaAccount1",
        "session_cookie": "aid=YOUR_AID; __Secure-session=YOUR_SESSION_VALUE",
        "show_session": true,
        "show_weekly": true,
        "enabled": true
      }
    ]
  }
}
